# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub.
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

GOOGLE_CLIENT_ID=

# Orígenes permitidos por CORS (URLs de los frontends, separadas por coma). Opcional en local.
CORS_ALLOWED_ORIGINS=

# Swagger (/swagger-ui.html). Poner false para ocultarlo en produccion.
SWAGGER_ENABLED=true

# Cloudinary (Settings > API Keys). Sin esto la subida de archivos responde 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo de recordatorios: ninguno | smtp (usa MAIL_*) | brevo (usa BREVO_API_KEY)
CORREO_PROVEEDOR=ninguno
CORREO_REMITENTE=
BREVO_API_KEY=

# Clave de cifrado de historias clinicas (Base64 de 32 bytes). Generala tu y guarda una copia aparte.
HISTORIA_CLINICA_CLAVE=

# Pagos: simulado (sin pasarela) o culqi. Llaves del panel de Culqi (pk_test/sk_test = modo prueba).
PAGOS_MODO=simulado
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Push (Firebase): JSON de la cuenta de servicio en Base64 (Configuracion del proyecto > Cuentas de servicio).
FIREBASE_CREDENCIALES=
