# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube a GitHub.
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

GOOGLE_CLIENT_ID=

# Orígenes permitidos por CORS (URLs de los frontends, separadas por coma). Opcional en local.
CORS_ALLOWED_ORIGINS=

# Swagger (/swagger-ui.html). Poner false para ocultarlo en produccion.
SWAGGER_ENABLED=true
