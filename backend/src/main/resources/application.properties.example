# Conexion a Supabase (reemplazar con los datos reales del proyecto)
spring.datasource.url=jdbc:postgresql://<TU_HOST_SUPABASE>:5432/postgres
spring.datasource.username=postgres
spring.datasource.password=<TU_PASSWORD_SUPABASE>
spring.datasource.driver-class-name=org.postgresql.Driver

# Hibernate: en desarrollo "update" crea/ajusta tablas automaticamente segun las entidades
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Puerto local del backend
server.port=8080
